{
  "name": "twint-ag/twint-woocommerce-extension",
  "description": "TWINT payment plugin for WooCommerce",
  "keywords": [
    "twint",
    "twint.ch",
    "switzerland",
    "checkout",
    "regular checkout",
    "express checkout",
    "payment",
    "wordpress",
    "woocommerce",
    "woocommerce-extension"
  ],
  "version": "1.6.19",
  "type": "wordpress-plugin",
  "license": [
    "MIT"
  ],
  "autoload": {
    "psr-4": {
      "Twint\\Woo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "TWINT",
      "email": "plugin@twint.ch",
      "role": "Maintainer",
      "homepage": "https://www.twint.ch/"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.1",
    "ext-dom": "*",
    "ext-mysqli": "*",
    "ext-openssl": "*",
    "ext-xsl": "*",
    "guzzlehttp/guzzle": "^7.0",
    "symfony/console": "^6.4",
    "twint-ag/sdk": "^1.0",
    "sniccowp/php-scoper-wordpress-excludes": "^6.6",
    "yahnis-elsts/plugin-update-checker": "5.6",
    "maennchen/zipstream-php": ">=3.1.1",
    "symfony/filesystem": "^6.4",
    "symfony/process": "*"
  },
  "require-dev": {
    "symfony/var-dumper": ">=6.4",
    "symplify/easy-coding-standard": ">=12.3",
    "slevomat/coding-standard": ">=8.15",
    "rector/rector": "~2.1.0",
    "phpstan/phpstan": ">=1.12.10",
    "szepeviktor/phpstan-wordpress": ">=1.3.5",
    "phpstan/extension-installer": ">=1.4.3",
    "php-stubs/woocommerce-stubs": ">=9.3",
    "wp-cli/wp-cli-bundle": "^2.12",
    "squizlabs/php_codesniffer": "^3.0"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "composer/installers": false,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
