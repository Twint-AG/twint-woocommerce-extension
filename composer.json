{
  "name": "twint-ag/twint-woocommerce-extension",
  "description": "TWINT payment plugin for WooCommerce",
  "keywords": [
    "twint",
    "twint.ch",
    "switzerland",
    "checkout",
    "regular checkout",
    "express checkout",
    "payment",
    "wordpress",
    "woocommerce",
    "woocommerce-extension"
  ],
  "version": "1.0.0-RC27",
  "type": "wordpress-plugin",
  "license": [
    "MIT"
  ],
  "autoload": {
    "psr-4": {
      "Twint\\Woo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "TWINT",
      "email": "plugin@twint.ch",
      "role": "Maintainer",
      "homepage": "https://www.twint.ch/"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.1",
    "ext-dom": "*",
    "ext-mysqli": "*",
    "ext-openssl": "*",
    "ext-xsl": "*",
    "guzzlehttp/guzzle": "^7.0",
    "symfony/console": "*",
    "symfony/process": "*",
    "twint-ag/sdk": "1.4.2",
    "sniccowp/php-scoper-wordpress-excludes": "^6.6"
  },
  "require-dev": {
    "symfony/var-dumper": ">=6.4",
    "symplify/easy-coding-standard": ">=12.3",
    "slevomat/coding-standard": ">=8.15",
    "rector/rector": ">=1.2.10",
    "phpstan/phpstan": ">=1.12.10",
    "szepeviktor/phpstan-wordpress": ">=1.3.5",
    "phpstan/extension-installer": ">=1.4.3",
    "php-stubs/woocommerce-stubs": ">=9.3"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "composer/installers": false,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://git.nfq.asia/twint-ag/sdk"
    }
  ]
}
