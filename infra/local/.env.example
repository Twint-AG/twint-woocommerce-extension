# Copy to .env (gitignored) and fill in. Values below are safe local defaults.

# Database
DB_ROOT_PASSWORD=rootpass
DB_USER=twint            # must match the GRANT in mysql-init/01-databases.sql
DB_PASSWORD=twintpass

# WordPress admin (created by wp-cli on first boot)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# WooCommerce version per instance ("" = latest)
WC_LATEST_WOO_VERSION=
WC_OLDEST_WOO_VERSION=6.0.0

# TWINT SDK (twint-ag/sdk:dev-dev/v9) — private repo creds for composer (needs VPN)
GITLAB_USERNAME=
GITLAB_TOKEN=
