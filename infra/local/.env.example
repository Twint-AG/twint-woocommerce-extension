# Copy to .env (gitignored) and fill in. Values below are safe local defaults.

# Database
DB_ROOT_PASSWORD=rootpass
DB_USER=twint            # must match the GRANT in mysql-init/01-databases.sql
DB_PASSWORD=twintpass

# WordPress admin (created by wp-cli on first boot)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# WooCommerce version per instance ("" = latest)
WC_LATEST_WOO_VERSION=
WC_OLDEST_WOO_VERSION=6.0.0

# Base image per instance — change these to test a different PHP/WP version.
# e.g. WC_LATEST_IMAGE=wordpress:php8.2  (rebuild: docker compose up -d --build)
WC_LATEST_IMAGE=wordpress:php8.3
WC_OLDEST_IMAGE=wordpress:5.9-php8.1

# Site URL per instance. TWINT rejects localhost, a non-standard :port, AND non-
# https callback URLs. wc_latest is therefore served as https://latest.wordpress.local
# via the `proxy` (Caddy) service on :443, using an mkcert cert (see README).
# Add matching entries to /etc/hosts:
#   127.0.0.1 latest.wordpress.local oldest.wordpress.local
WC_LATEST_URL=https://latest.wordpress.local
WC_LATEST_PORT=80          # wc_latest's own http port (proxy reaches it internally)
# wc_oldest keeps plain http:port (can't run the EC dev SDK, no TWINT redirect there)
WC_OLDEST_URL=http://oldest.wordpress.local:8082
WC_OLDEST_PORT=8082

# TWINT SDK (twint-ag/sdk:dev-dev/v9) — private repo creds for composer (needs VPN)
GITLAB_USERNAME=
GITLAB_TOKEN=
