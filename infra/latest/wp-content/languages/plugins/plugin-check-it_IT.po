#. Description of the plugin
#: plugin.php
msgid "Plugin Check is a WordPress.org tool which provides checks to help plugins meet the directory requirements and follow various best practices."
msgstr "Plugin Check è uno strumento di WordPress.org che fornisce controlli per aiutare i plugin a soddisfare i requisiti della directory e a seguire varie best practice."

#: includes/Admin/Admin_AJAX.php:282
msgid "Checks run successfully"
msgstr "I controlli sono stati eseguiti con successo"

#: includes/Admin/Admin_AJAX.php:303
msgid "Invalid user permissions, you are not allowed to perform this request."
msgstr "Autorizzazione utente non valida, non sei autorizzato a eseguire questa richiesta."

#: includes/Checker/Abstract_Check_Runner.php:246
msgid "Invalid plugin: The plugin set does not match the original request parameter."
msgstr "Plugin non valido: il plugin non corrisponde al parametro della richiesta originale."

#: includes/Checker/Abstract_Check_Runner.php:202
msgid "Invalid checks: The checks to run do not match the original request."
msgstr "Controlli non validi: i controlli da eseguire non corrispondono alla richiesta originale."

#: includes/Checker/Abstract_Check_Runner.php:224
msgid "Invalid checks: The checks to exclude do not match the original request."
msgstr "Controlli non validi: i controlli da escludere non corrispondono alla richiesta originale."

#. translators: 1: plugin header tag; 2: Example version 5.2.4. 3: Example
#. version 7.0.
#: includes/Checker/Checks/Plugin_Repo/Plugin_Readme_Check.php:561
msgid "The \"%1$s\" field was ignored. This field should only contain a PHP version such as \"%2$s\" or \"%3$s\"."
msgstr "Il campo \"%1$s\" è stato ignorato. Questo campo deve contenere solo una versione PHP come \"%2$s\" o \"%3$s\"."

#. translators: 1: section title; 2: maximum limit
#: includes/Checker/Checks/Plugin_Repo/Plugin_Readme_Check.php:610
#: includes/Checker/Checks/Plugin_Repo/Plugin_Readme_Check.php:633
msgid "The \"%1$s\" section is too long and was truncated. A maximum of %2$d character is supported."
msgid_plural "The \"%1$s\" section is too long and was truncated. A maximum of %2$d characters is supported."
msgstr[0] "La sezione \"%1$s\" è troppo lunga ed è stata troncata. È ammesso al massimo %2$d carattere."
msgstr[1] "La sezione %1$s è troppo lunga ed è stata troncata. È ammesso un massimo di %2$d caratteri."

#. translators: %s: section title
#: includes/Checker/Checks/Plugin_Repo/Plugin_Readme_Check.php:603
msgid "The \"%s\" section is missing. An excerpt was generated from your main plugin description."
msgstr "Manca la sezione \"%s\". Un riassunto è stato generato dalla descrizione principale del tuo plugin."

#. translators: 1: plugin header tag; 2: Example version 5.0. 3: Example
#. version 5.1.
#. translators: 1: plugin header tag; 2: Example version 5.0. 3: Example
#. version 4.9.
#: includes/Checker/Checks/Plugin_Repo/Plugin_Readme_Check.php:570
#: includes/Checker/Checks/Plugin_Repo/Plugin_Readme_Check.php:580
msgid "The \"%1$s\" field was ignored. This field should only contain a valid WordPress version such as \"%2$s\" or \"%3$s\"."
msgstr "Il campo \"%1$s\" è stato ignorato. Questo campo deve contenere solo una versione valida di WordPress come \"%2$s\" o \"%3$s\"."

#. translators: %s: plugin header tag
#: includes/Checker/Checks/Plugin_Repo/Plugin_Readme_Check.php:554
msgid "One or more contributors listed were ignored. The \"%s\" field should only contain WordPress.org usernames. Remember that usernames are case-sensitive."
msgstr "Uno o più contributori elencati sono stati ignorati. Il campo \"%s\" deve contenere solo nomi utente WordPress.org. Ricorda che i nomi utente fanno distinzione tra maiuscole e minuscole."

#. translators: 1: plugin slug, 2: found trademarked term
#: includes/Checker/Checks/Plugin_Repo/Trademarks_Check.php:402
msgid "The plugin slug includes a restricted term. Your plugin slug - \"%1$s\" - contains the restricted term \"%2$s\" which cannot be used at all in your plugin slug."
msgstr "Lo slug del plugin include un termine riservato. Lo slug del tuo plugin - \"%1$s\" - contiene il termine riservato \"%2$s\" che non può essere utilizzato affatto nello slug del tuo plugin."

#. translators: %s: Example plugin name header
#: includes/Checker/Checks/Plugin_Repo/Plugin_Readme_Check.php:139
msgid "We cannot find a plugin name in your readme. Please update your readme with a valid plugin name header. Eg: \"%s\""
msgstr "Non riusciamo a trovare il nome di un plugin nel tuo file readme. Aggiorna il tuo file Leggimi con un nome nel header del plugin valido. Esempio: \"%s\""

#. translators: %s: The Check slug.
#: includes/Checker/Empty_Check_Repository.php:70
msgid "Check with slug \"%s\" has no categories associated with it."
msgstr "Controlla con lo slug \"%s\" che non ci siano categorie ad esso associate."

#. translators: %s: The Check slug.
#: includes/Checker/Empty_Check_Repository.php:50
msgid "Check with slug \"%s\" must be an instance of Runtime_Check or Static_Check."
msgstr "Il controllo con slug \"%s\" deve essere un'istanza di Runtime_Check o Static_Check."

#. translators: 1: plugin slug, 2: found trademarked term
#: includes/Checker/Checks/Plugin_Repo/Trademarks_Check.php:394
msgid "The plugin slug includes a restricted term. Your plugin slug - \"%1$s\" - contains the restricted term \"%2$s\" which cannot be used within in your plugin slug, unless your plugin slug ends with \"for %2$s\". The term must still not appear anywhere else in your plugin slug."
msgstr "Lo slug del plugin contiene un termine riservato. Lo slug del plugin che hai scelto - \"%1$s\" - contiene il termine riservato \"%2$s\", che non può essere utilizzato nello slug del tuo plugin, a meno che lo slug del tuo plugin termini con \"for %2$s\". Il termine non deve comparire altrove nello slug del plugin."

#. translators: 1: plugin name, 2: found trademarked term
#: includes/Checker/Checks/Plugin_Repo/Trademarks_Check.php:355
msgid "The plugin name includes a restricted term. Your chosen plugin name - \"%1$s\" - contains the restricted term \"%2$s\" which cannot be used at all in your plugin name."
msgstr "Il nome del plugin include un termine riservato. Il nome del tuo plugin - \"%1$s\" - contiene il termine riservato \"%2$s\" che non può essere utilizzato affatto nel nome del tuo plugin."

#. translators: 1: plugin header field, 2: plugin header text domain, 3: plugin
#. slug
#: includes/Checker/Checks/Plugin_Repo/Plugin_Header_Fields_Check.php:290
msgid "The \"%1$s\" header in the plugin file does not match the slug. Found \"%2$s\", expected \"%3$s\"."
msgstr "Il \"%1$s\" header nel file del plugin non corrisponde allo slug. Trovato \"%2$s\", previsto \"%3$s\"."

